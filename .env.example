# Secret untuk menandatangani sesi login dan tiket Socket.IO. Gunakan nilai acak yang panjang; samakan dengan JWT_SECRET di server Socket.IO.
JWT_SECRET=replace-with-a-long-random-secret

# Alamat koneksi MongoDB, termasuk nama pengguna, kata sandi, dan cluster database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=tagihan

# Secret bersama untuk mengautentikasi pengiriman event dari aplikasi Next.js ke server Socket.IO.
# Isi dengan nilai rahasia yang sama di aplikasi Next.js dan server Socket.IO.
SOCKET_PUBLISH_SECRET=replace-with-a-separate-random-secret

# Alamat server Socket.IO yang diakses dari sisi server Next.js untuk mengirim event chat.
SOCKET_SERVER_URL=http://localhost:3001

# Alamat server Socket.IO yang diakses browser untuk menerima pembaruan chat secara real-time.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# Origin/domain aplikasi web yang diizinkan server Socket.IO menerima koneksi browser.
# Untuk beberapa domain, pisahkan dengan koma. Saat lokal, gunakan http://localhost:3000.
APP_ORIGIN=http://localhost:3000
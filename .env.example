# Secret untuk menandatangani sesi login. Gunakan nilai acak yang panjang.
JWT_SECRET=replace-with-a-long-random-secret

# Alamat koneksi MongoDB, termasuk nama pengguna, kata sandi, dan cluster database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=tagihan

# Nilai dari App Keys pada aplikasi Pusher Channels. Secret hanya digunakan di server.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

# Key dan cluster yang sama dengan PUSHER_APP_KEY dan PUSHER_APP_CLUSTER untuk koneksi browser.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

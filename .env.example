# Secret untuk menandatangani sesi login. Gunakan nilai acak yang panjang.
JWT_SECRET=replace-with-a-long-random-secret

# Kunci enkripsi API Key Chat AI. Buat dengan: openssl rand -base64 32
# Simpan sebagai secret di hosting dan jangan mengubahnya setelah menyimpan API Key AI.
CHAT_AI_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Alamat koneksi MongoDB, termasuk nama pengguna, kata sandi, dan cluster database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=tagihan

# Opsional: nama header IP klien kalau deploy di belakang proxy tertentu.
# Kosongkan untuk deteksi otomatis (x-forwarded-for, x-real-ip, cf-connecting-ip, dll).
# CLIENT_IP_HEADER=x-forwarded-for

# Wajib di production untuk membuat akun superadmin pertama melalui /api/seed.
SEED_SECRET=replace-with-another-long-random-secret
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
